# Keep the build context small and, more importantly, keep real financial
# data out of the image entirely.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

.git/
.github/
.gitignore
.dockerignore

tests/
tools/
README.md
*.md

# Real data and anything derived from it. Only data/samples is copied in,
# and that is done explicitly in the Dockerfile.
data/
!data/samples/
backups/
exports/
*.xlsx
*.xls
*.csv

.streamlit/secrets.toml
.env
